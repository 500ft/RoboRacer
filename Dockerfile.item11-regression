FROM python:3.10-slim-bookworm

ENV OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_CORETYPE=Haswell \
    PYTHONPATH=/workspace/gym

WORKDIR /workspace
COPY requirements-item11-regression.txt .
RUN pip install --no-cache-dir -r requirements-item11-regression.txt
COPY gym ./gym
COPY experiments ./experiments
COPY evidence ./evidence

# Log the host CPU model first: strict-mode drift has been runner-dependent, and the
# CPU vendor/SIMD level is the variable that OPENBLAS_CORETYPE alone does not pin.
CMD ["sh", "-c", "grep -m1 'model name' /proc/cpuinfo || true; python experiments/validate_item11.py --strict"]
